{"nodes": [{"id": "readme_winisd_modern", "label": "WinISD Modern", "file_type": "document", "source_file": "README.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds the twenty-year-old WinISD idea with a real circuit solver instead of closed-form alignment tables, multiple drivers on shared graphs, and honest limits drawn on the model rather than left for the user to know about."}, {"id": "readme_winisd", "label": "WinISD (original tool)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 7-9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_modified_nodal_analysis", "label": "Modified nodal analysis solver", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 102-106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each enclosure is built as nodes and elements (driver, chamber, port, passive radiator, radiation load) and every frequency point is one complex admittance solve. Chosen so adding an enclosure type means describing its topology rather than deriving and writing new response mathematics."}, {"id": "readme_lumped_parameter_simulation", "label": "Lumped-parameter simulation", "file_type": "concept", "source_file": "README.md", "source_location": "lines 60-63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models only the electro-mechano-acoustic circuit: no cone breakup, no directivity, no baffle diffraction. Accepted as the honest scope of every tool of this kind."}, {"id": "readme_ka_0_5_piston_limit", "label": "ka = 0.5 piston-model limit", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 41-42, 62-63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Above roughly ka = 0.5 a lumped simulation has nothing useful to say, so the graphs shade that region instead of quietly drawing a flat line through it - the limit is shown rather than left implicit."}, {"id": "readme_auto_alignment_solver", "label": "Auto-alignment solver", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 25-31, 107-108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Searches the actual circuit model for the best box and tuning rather than using classic closed-form formulas, so it works across the whole Qts range instead of only where those formulas hold. It drives the same model as the display path, so a recommendation always matches the curve shown."}, {"id": "readme_alignment_constraints", "label": "Alignment constraints and binding report", "file_type": "concept", "source_file": "README.md", "source_location": "lines 30-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional constraints (Xmax at rated power, buildable port, box volume cap, target F3) and the solver reports which one bound the result, so an unexpected answer is explainable."}, {"id": "readme_transfer_function_normalisation", "label": "Transfer function normalisation", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 36-38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalised against the same driver in free air so coil, sensitivity and radiation model divide out and the curve shows what the enclosure alone contributes."}, {"id": "readme_maximum_spl", "label": "Maximum SPL ceiling", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 39-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes the lower of the excursion and thermal ceilings and marks which one is binding, rather than reporting a single unattributed number."}, {"id": "readme_enclosure_topologies", "label": "Enclosure topologies", "file_type": "concept", "source_file": "README.md", "source_location": "lines 17-23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_custom_topology_builder", "label": "Custom topology builder", "file_type": "concept", "source_file": "README.md", "source_location": "line 20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists because the nodal formulation makes an arbitrary topology just another netlist, so anything the standard enclosure types do not cover can still be described."}, {"id": "readme_enclosure_losses", "label": "Enclosure and port losses (Ql)", "file_type": "concept", "source_file": "README.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modelled explicitly rather than assuming a lossless box."}, {"id": "readme_signal_chain", "label": "Signal chain (EQ, crossover, room, cabin gain)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 45-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passive crossover networks are evaluated against the driver's real complex load rather than a nominal resistance; in-room response uses image sources."}, {"id": "readme_driver_database", "label": "Driver database with Thiele/Small checks", "file_type": "concept", "source_file": "README.md", "source_location": "line 52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistency checks state what they cannot verify instead of implying a clean bill of health."}, {"id": "readme_project_and_workspace_files", "label": "Projects (.wproj) and workspaces (.wsp)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 53-54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two file scopes: one design versus a whole comparison, plus automatic session restore."}, {"id": "readme_tauri_react_rust_stack", "label": "Tauri + React/TypeScript + Rust stack", "file_type": "concept", "source_file": "README.md", "source_location": "lines 11, 110-112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acoustics live in Rust (nalgebra, num-complex) for the numeric solve; UI in React, TypeScript, Tailwind; Tauri bridges them into a desktop app."}], "edges": [{"source": "_github_workflows_ci_portgeometry", "target": "readme_enclosure_topologies", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": "lines 21-22", "weight": 1.0}, {"source": "_github_workflows_ci_effectivevas", "target": "readme_modified_nodal_analysis", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": "lines 102-106", "weight": 1.0}, {"source": "_github_workflows_ci_rust", "target": "readme_auto_alignment_solver", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "line 94", "weight": 1.0}, {"source": "readme_winisd_modern", "target": "readme_winisd", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "lines 7-9", "weight": 1.0}, {"source": "readme_winisd_modern", "target": "readme_modified_nodal_analysis", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "lines 102-106", "weight": 1.0}, {"source": "readme_winisd_modern", "target": "readme_tauri_react_rust_stack", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 11", "weight": 1.0}, {"source": "readme_auto_alignment_solver", "target": "readme_m